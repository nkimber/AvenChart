# Copy to .env.staging (which is ignored by Git), replace the placeholder with
# a randomly generated value, then run the documented Compose command.
AVENCHART_STAGING_POSTGRES_PASSWORD=replace-with-a-random-local-staging-password

# The UI binds only to this loopback port. It is not a public deployment.
AVENCHART_STAGING_PORT=8088
