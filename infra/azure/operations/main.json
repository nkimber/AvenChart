              "sku": {
                "name": "[parameters('postgresSkuName')]",
                "tier": "[parameters('postgresTier')]"
              },
              "properties": {
                "version": "17",
                "administratorLogin": "[parameters('databaseAdministratorLogin')]",
                "administratorLoginPassword": "[parameters('databaseAdministratorPassword')]",
                "availabilityZone": "1",
                "backup": {
