<Project>
  <PropertyGroup>
    <!-- Make the SDK analyzer and code-style contract explicit across API and test projects. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
