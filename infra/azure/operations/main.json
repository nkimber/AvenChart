              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), 'key-vault-secrets-user')]",
              "properties": {
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]",
                "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), parameters('deploymentPrincipalObjectId'), 'key-vault-secrets-officer')]",
              "properties": {
                "principalId": "[parameters('deploymentPrincipalObjectId')]",
                "principalType": "[parameters('deploymentPrincipalType')]",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
              ]
            },
            {
              "condition": "[and(greater(parameters('monthlyBudgetUsd'), 0), greater(length(parameters('alertEmails')), 0))]",
              "type": "Microsoft.Consumption/budgets",
              "apiVersion": "2023-11-01",
              "name": "[format('{0}-monthly-budget', parameters('resourceNamePrefix'))]",
              "properties": {
                "amount": "[parameters('monthlyBudgetUsd')]",
                "category": "Cost",
                "timeGrain": "Monthly",
                "timePeriod": {
                  "startDate": "[parameters('budgetStartDate')]",
                  "endDate": "2036-12-31"
                },
                "notifications": {
                  "actual50": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": 50,
                    "thresholdType": "Actual",
                    "contactEmails": "[parameters('alertEmails')]"
                  },
                  "actual80": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": 80,
                    "thresholdType": "Actual",
                    "contactEmails": "[parameters('alertEmails')]"
                  },
                  "forecast100": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": 100,
                    "thresholdType": "Forecasted",
                    "contactEmails": "[parameters('alertEmails')]"
                  }
                }
              }
            }
