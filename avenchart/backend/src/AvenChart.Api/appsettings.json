{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RuntimeSafety": {
    "RequireHttps": false,
    "RateLimitPermitLimit": 120,
    "RateLimitWindowSeconds": 60,
    "RateLimitQueueLimit": 0
  },
  "Telehealth": {
    "Enabled": false,
    "Mode": "Synthetic",
    "PracticeId": "avenchart-synthetic-practice",
    "PracticeDisplayName": "AvenChart Synthetic Practice",
    "FacilityId": 10,
    "BrandedHosts": [
      "localhost",
      "127.0.0.1"
    ],
    "SupportedStates": [
      "GA",
      "CA",
      "FL"
    ],
    "ReservationLeaseSeconds": 120,
    "VideoAdapterMode": "NON_PRODUCTION",
    "PharmacyDirectoryAdapterMode": "NON_PRODUCTION",
    "ProfessionalClaimAdapterMode": "NON_PRODUCTION"
  },
  "IdentityProvider": {
    "Mode": "local",
    "ProviderId": "local-development",
    "SubjectClaim": "sub",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 60,
    "BrowserClientId": "avenchart-modern-ui",
    "BrowserScopes": "openid profile",
    "BrowserAllowedOrigins": [
      "http://localhost:3100",
      "http://127.0.0.1:3100"
    ],
    "EnableBrowserBff": false,
    "BrowserStateLifetimeSeconds": 300,
    "TestIssuer": "http://localhost:5001/api/test-idp",
    "TestAudience": "avenchart-api",
    "TestTokenLifetimeMinutes": 15
  },
  "ReportExecution": {
    "PollIntervalMilliseconds": 250,
    "EnqueueDelayMilliseconds": 500,
    "HeartbeatIntervalMilliseconds": 1000,
    "LeaseSeconds": 30,
    "ExecutionTimeoutSeconds": 20,
    "QueueExpirationMinutes": 15,
    "MaxAttempts": 3,
    "RetryBaseDelaySeconds": 1
  },
  "DatabaseConnection": {
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "CancellationTimeoutMilliseconds": 2000,
    "MinimumPoolSize": 0,
    "MaximumPoolSize": 100,
    "KeepAliveSeconds": 30
  },
  "AzureOperations": {
    "Enabled": true,
    "AllowPlanExecution": true,
    "AllowDeploymentExecution": false,
    "AzureCliPath": "az",
    "CommandTimeoutMinutes": 30,
    "MigrationTimeoutMinutes": 30,
    "AccessGrantMinutes": 15,
    "UnlockMaximumFailures": 5,
    "UnlockFailureWindowMinutes": 15,
    "UnlockLockoutMinutes": 15,
    "AccessCodeHashIterations": 310000
  },
  "AllowedHosts": "*"
}
